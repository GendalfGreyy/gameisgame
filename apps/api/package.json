{
  "name": "@game-is-game/api",
  "version": "0.0.0",
  "private": true,
  "description": "NestJS backend — auth, events, check-ins, points, payments, moderation.",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "dev": "env -u TELEGRAM_BOT_TOKEN node --env-file=../../.env ./node_modules/tsx/dist/cli.mjs watch src/main.ts",
    "start": "node dist/main.js",
    "test": "vitest run",
    "lint": "echo 'lint runs from root' && exit 0",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@game-is-game/db": "workspace:*",
    "@game-is-game/shared": "workspace:*",
    "@nestjs/common": "^11.0.7",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.7",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/platform-express": "^11.0.7",
    "@telegram-apps/init-data-node": "^2.0.10",
    "bullmq": "^5.34.8",
    "ioredis": "^5.4.2",
    "nestjs-pino": "^4.2.0",
    "pino": "^9.6.0",
    "pino-http": "^10.3.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.2",
    "@nestjs/schematics": "^11.0.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.5",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.2",
    "vitest": "^3.0.4"
  }
}
