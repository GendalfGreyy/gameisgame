{
  "name": "@tg-creator/studio",
  "version": "0.0.0",
  "private": true,
  "description": "TG Creator Studio Mini App: auth, dashboard, wizard, settings (G1).",
  "type": "module",
  "scripts": {
    "build": "tsc -b && vite build",
    "start": "vite preview --host 0.0.0.0 --port ${PORT:-4174}",
    "dev": "vite",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lint": "echo 'lint runs from root' && exit 0",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/onest": "^5.3.1",
    "@fontsource-variable/unbounded": "^5.3.0",
    "@tg-creator/project-schema": "workspace:*",
    "@tg-creator/shared": "workspace:*",
    "@tg-creator/telegram": "workspace:*",
    "@tg-creator/ui-kit": "workspace:*",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.1",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^3.0.4"
  }
}
