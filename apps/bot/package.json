{
  "name": "@game-is-game/bot",
  "version": "0.0.0",
  "private": true,
  "description": "Telegram bot (grammY) — commands, deep links, notification consumer.",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "env -u TELEGRAM_BOT_TOKEN node --env-file=../../.env ./node_modules/tsx/dist/cli.mjs watch src/main.ts",
    "start": "node dist/main.js",
