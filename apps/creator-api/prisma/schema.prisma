// TG Creator Studio Prisma schema.
// Lives in its own Postgres schema (`?schema=creator` in CREATOR_DATABASE_URL),
// so it never shares tables or `_prisma_migrations` with @game-is-game/db.

generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("CREATOR_DATABASE_URL")
}

/// Bootstrap marker kept from G0.
model CreatorSchemaMeta {
  id        String   @id @default("singleton")
  version   Int      @default(1)
  updatedAt DateTime @updatedAt

  @@map("creator_schema_meta")
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  telegramId   BigInt   @unique @map("telegram_id")
  firstName    String   @map("first_name")
  lastName     String?  @map("last_name")
  username     String?
  photoUrl     String?  @map("photo_url")
  languageCode String?  @map("language_code")
  /// `{theme, density}` — validated by userPreferencesSchema on read and write.
  preferences  Json     @default("{}")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  sessions Session[]
  projects Project[]

  @@map("users")
}

model Session {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  /// SHA-256 of the bearer token; the token itself is never stored.
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

enum ProjectType {
  game3d
  game2d
  app
}

enum ProjectStatus {
  draft
  archived
}

model Project {
  id        String        @id @default(uuid()) @db.Uuid
  ownerId   String        @map("owner_id") @db.Uuid
  title     String
  type      ProjectType
  status    ProjectStatus @default(draft)
  revision  Int           @default(1)
  /// Current draft ProjectDocument (schemaVersion inside).
  document  Json
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")
  deletedAt DateTime?     @map("deleted_at")

  owner     User            @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  mutations DraftMutation[]

  @@index([ownerId, deletedAt, updatedAt(sort: Desc), id(sort: Desc)])
  @@map("projects")
}

/// Idempotency journal for `PUT /projects/:id/draft` (docs/04 §3): a replayed
/// `mutationId` returns the stored result instead of writing twice. Lives in Postgres,
/// not a TTL cache, so a retry after a server restart is still safe.
model DraftMutation {
  projectId    String   @map("project_id") @db.Uuid
  mutationId   String   @map("mutation_id")
  baseRevision Int      @map("base_revision")
  /// SHA-256 of the canonical serialized document that was saved.
  documentHash String   @map("document_hash")
  revision     Int
  savedAt      DateTime @map("saved_at")
  createdAt    DateTime @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([projectId, mutationId])
  @@index([projectId, createdAt])
  @@map("draft_mutations")
}
