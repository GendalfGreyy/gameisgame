{
  "name": "@tg-creator/creator-api",
  "version": "0.0.0",
  "private": true,
  "description": "TG Creator Studio NestJS API — auth, me, projects (G1).",
  "type": "module",
  "scripts": {
    "build": "prisma generate && nest build",
    "dev": "node --env-file-if-exists=../../.env ./node_modules/tsx/dist/cli.mjs watch src/main.ts",
    "start": "node dist/main.js",
    "test": "vitest run --exclude 'src/**/*.int-spec.ts'",
    "lint": "echo 'lint runs from root' && exit 0",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "clean": "rm -rf dist .turbo generated",
    "prisma": "node --env-file-if-exists=../../.env ./node_modules/prisma/build/index.js",
    "postinstall": "prisma generate",
    "test:int": "node --env-file-if-exists=../../.env ./node_modules/vitest/vitest.mjs run --config vitest.int.config.ts",
    "db:migrate": "pnpm run prisma migrate dev",
    "db:deploy": "pnpm run prisma migrate deploy",
    "start:prod": "pnpm run db:deploy && node dist/main.js",
    "start:dev": "node --env-file-if-exists=../../.env ./node_modules/tsx/dist/cli.mjs src/main.ts",
    "db:seed": "node --env-file-if-exists=../../.env ./node_modules/tsx/dist/cli.mjs src/seed.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.7",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.7",
    "@nestjs/platform-express": "^11.0.7",
    "@prisma/client": "^6.2.1",
    "@tg-creator/shared": "workspace:*",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.24.1",
    "@tg-creator/project-schema": "workspace:*"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.2",
    "@nestjs/schematics": "^11.0.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.5",
    "prisma": "^6.2.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.0.4"
  }
}
