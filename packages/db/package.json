{
  "name": "@game-is-game/db",
  "version": "0.0.0",
  "private": true,
  "description": "Prisma schema, migrations, seed scripts. PostgreSQL + PostGIS.",
  "type": "module",
  "main": "./generated/client/index.js",
  "types": "./generated/client/index.d.ts",
  "exports": {
    ".": {
      "types": "./generated/client/index.d.ts",
      "import": "./generated/client/index.js",
      "default": "./generated/client/index.js"
    }
  },
  "scripts": {
    "build": "prisma generate",
    "postinstall": "prisma generate",
    "test": "echo 'no tests' && exit 0",
    "lint": "echo 'no lint (prisma-managed)' && exit 0",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .turbo generated",
    "prisma": "prisma"
  },
  "dependencies": {
    "@prisma/client": "^6.2.1"
  },
  "devDependencies": {
    "prisma": "^6.2.1",
    "tsx": "^4.19.2"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
