# Copy values into Railway service Variables (not a runnable .env file).
# Replace placeholders with your real domains and secrets.

# ── api ──────────────────────────────────────────────────────────────────────
NODE_ENV=production
DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require
REDIS_URL=${{Redis.REDIS_URL}}
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=gamelsgamebot
JWT_SECRET=
JWT_REFRESH_SECRET=
SERVICE_JWT_SECRET=
API_PUBLIC_URL=https://game-is-gameapi-production.up.railway.app
API_CORS_ORIGINS=https://[WEB-DOMAIN].up.railway.app
TELEGRAM_WEBAPP_URL=https://[WEB-DOMAIN].up.railway.app
LOG_LEVEL=info

# ── web (set BEFORE build / redeploy after change) ───────────────────────────
# VITE_API_URL=https://game-is-gameapi-production.up.railway.app
# VITE_MAPLIBRE_STYLE_URL=https://api.maptiler.com/maps/streets/style.json?key=YOUR_KEY

# ── bot (no public domain) ───────────────────────────────────────────────────
# TELEGRAM_BOT_TOKEN=same as api
# TELEGRAM_WEBAPP_URL=https://[WEB-DOMAIN].up.railway.app
# API_PUBLIC_URL=https://game-is-gameapi-production.up.railway.app
# REDIS_URL=${{Redis.REDIS_URL}}
# SERVICE_JWT_SECRET=same as api
