# =========================================================================
# .env.example  —  copy to .env (gitignored) and fill in real values.
# Production secrets must come from Doppler/Infisical, never from a checked-in file.
# =========================================================================

# ------------------------- Runtime -------------------------
NODE_ENV=development
LOG_LEVEL=debug                              # debug | info | warn | error

# ------------------------- Telegram -------------------------
TELEGRAM_BOT_TOKEN=                          # from @BotFather
TELEGRAM_BOT_USERNAME=                       # without @, e.g. gamegamebot
TELEGRAM_WEBAPP_URL=https://app.local.test  # public URL of apps/web (TG must reach it via HTTPS)

# ------------------------- API (apps/api) -------------------------
API_PORT=3001
API_PUBLIC_URL=http://localhost:3001
API_CORS_ORIGINS=http://localhost:5173,https://app.local.test
TELEGRAM_BOT_USERNAME=gamegamebot

# ------------------------- Web (apps/web) -------------------------
VITE_API_URL=http://localhost:3001
VITE_MAPLIBRE_STYLE_URL=https://api.maptiler.com/maps/streets/style.json?key=REPLACE_ME
VITE_SENTRY_DSN=
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com
VITE_BOOSTS_ENABLED=false
# Creator Studio Mini App only (no map/events). Use for the studio Railway service.
VITE_STUDIO_ONLY=false
# Bot copy/button for constructor-only Mini App
STUDIO_MINI_APP=false

# ------------------------- Database -------------------------
# Local dev: docker compose up -d
DATABASE_URL=postgresql://gamegame:gamegame@localhost:5432/gamegame?schema=public
# Railway + Supabase (IPv4): use Session pooler, NOT db.[ref].supabase.co direct host.
# postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL_SHADOW=postgresql://gamegame:gamegame@localhost:5432/gamegame_shadow?schema=public

# ------------------------- Redis -------------------------
REDIS_URL=redis://localhost:6379

# ------------------------- Auth (JWT) -------------------------
# Generate: openssl rand -base64 48
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
JWT_ISSUER=game-is-game
JWT_AUDIENCE=game-is-game-miniapp

# ------------------------- Check-in (rotating QR) -------------------------
# Dedicated secret for rotating QR check-in tokens; falls back to JWT_SECRET when empty.
# Generate: openssl rand -base64 48
CHECKIN_QR_SECRET=

# ------------------------- Service-to-service auth (bot ↔ api) -------------------------
SERVICE_JWT_SECRET=

# ------------------------- Observability -------------------------
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
POSTHOG_KEY=
POSTHOG_HOST=https://us.i.posthog.com
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=game-is-game-api

# ------------------------- Payments (Telegram Stars) -------------------------
# Stars use empty provider_token. Kept here only to make the flag explicit.
TELEGRAM_STARS_PROVIDER_TOKEN=
# Phase 8: Stripe (physical goods only — not MVP)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ------------------------- Rate limits / feature flags -------------------------
RATE_LIMIT_DEFAULT_PER_MIN=100
FEATURE_BOOSTS_ENABLED=false                 # phase 8 toggle
FEATURE_PAYMENTS_ENABLED=false               # phase 8 toggle

# ------------------------- Geo defaults -------------------------
DEFAULT_NEARBY_RADIUS_M=2000
MAX_NEARBY_RADIUS_M=10000
GEOHASH_PRECISION_APPROX=5                   # ~5 km cells for approximate-mode display

# ------------------------- Admin -------------------------
ADMIN_BOOTSTRAP_TELEGRAM_IDS=                # comma-separated TG IDs auto-promoted to role=admin on first login

# ------------------------- TG Creator Studio (G0+) -------------------------
# Separate apps: studio :5174, player :5175, creator-api :3010, worker (Planned)
CREATOR_API_PORT=3010
CREATOR_API_PUBLIC_URL=http://localhost:3010
CREATOR_API_CORS_ORIGINS=http://localhost:5174,http://localhost:5175
# Required. Dedicated Postgres schema — never share `public` with Game is Game.
CREATOR_DATABASE_URL=postgresql://gamegame:gamegame@localhost:5432/gamegame?schema=creator
# initData verification uses TELEGRAM_BOT_TOKEN (above). Window for auth_date:
CREATOR_AUTH_MAX_AGE_SECONDS=86400
CREATOR_SESSION_TTL_HOURS=168
CREATOR_PROJECT_QUOTA=50
# POST /auth/dev — honoured only with NODE_ENV=development; API refuses to boot with it in production.
CREATOR_DEV_AUTH=false
VITE_CREATOR_API_URL=http://localhost:3010
# Shows the dev-login button outside Telegram in non-dev builds (server still enforces NODE_ENV).
VITE_CREATOR_DEV_AUTH=false

